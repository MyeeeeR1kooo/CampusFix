# Local coursework demo only. Replace placeholders before starting.
POSTGRES_DB=campusfix
POSTGRES_USER=campusfix
POSTGRES_PASSWORD=replace-demo-database-password
# URL password must match POSTGRES_PASSWORD and be URL-encoded if it has reserved characters.
# "db" is the Compose network hostname; native development uses localhost instead.
DATABASE_URL=postgresql+psycopg://campusfix:replace-demo-database-password@db:5432/campusfix
SECRET_KEY=replace-this-with-a-random-secret-of-at-least-32-characters
WEB_PORT=8080
ALLOWED_ORIGINS=http://localhost:8080
# Use invented demo passwords; never use campus credentials. The seed command requires all three.
SEED_REPORTER_PASSWORD=
SEED_TECHNICIAN_PASSWORD=
SEED_ADMIN_PASSWORD=
# Once #48 provides a built frontend, set this to frontend/dist and rebuild web.
FRONTEND_DIST=deploy/web/bootstrap
